%% Optimization starts


Results = table();



battery = batteries(1,:);
panel = solar(1,:);

Csol = panel.SolarCost_USD_MW_;
SolarDensity = panel.SolarDensity_MW_km__;

Cbat = battery.BatteryCost_USD_MWh_;
eta = battery.Round_TripEfficiency__OrDecimal_;
DoD = battery.DepthOfDischarge___;



for c = 1:numCountries

    country = countries(c,:);

    fprintf('\n=====================================\n');
    fprintf('Country: %s\n', country.Country{1});
    fprintf('=====================================\n');

    CFcorr = country.CorrectedCapacityFactor;
    AvailableLand = country.LandAreaAvailableForSolar_km__;
    Reliability = country.TargetReliability___;

  
    %% Loop through 2026 to 2045
    

    for k = 1:length(FutureYears)

        Year = FutureYears(k);

        Demand = DemandProjectionTable{c, k+1};
        DailyDemand = Demand / 365;
        Budget = BudgetProjectionTable{c, k+1};

       
        %% OBJECTIVE FUNCTION
        %% Maximize total energy delivered to demand
      
        f = [ 
            -8760 * CFcorr
            -(eta * DoD) 
        ];

       
        %% CONSTRAINTS
        

        % Constraint 1: Cap Total Energy Met at Demand
        A1 = [ (8760 * CFcorr), (eta * DoD) ];
        b1 = Demand;

        % Constraint 2: Cap Total Cost at Yearly Budget
        A2 = [ Csol, Cbat ];
        b2 = Budget;

        % Constraint 3: Cap Land Usage at Available Land
        A3 = [ 1/SolarDensity, 0 ];
        b3 = AvailableLand;

        % Constraint 4: Battery Storage for Daily Reliability
        A4 = [ 0, 1 ];
        b4 = Reliability * DailyDemand;

        % Constraint 5: Dynamic Storage Coupling over time
        % Ramps hours of peak storage from 2 hrs in 2026 to 6 hrs in 2045
        min_hours = 2;
        max_hours = 6;
        hours_of_storage = min_hours + (max_hours - min_hours) * ((k - 1) / (length(FutureYears) - 1));

        A5 = [ (CFcorr * hours_of_storage), -1 ];
        b5 = 0;

      
        A = [ A1; A2; A3; A4; A5 ];
        b = [ b1; b2; b3; b4; b5 ];
        lb = [0; 0];

        
        options = optimoptions('linprog', 'Display', 'off');

        [z, fval, exitflag] = linprog( ...
            f, ...
            A, ...
            b, ...
            [], ...
            [], ...
            lb, ...
            [], ...
            options);

        %% INFEASIBLE CASES
        if exitflag <= 0

            fprintf('%d : No feasible solution\n', Year);

            NewRow = table( ...
                string(country.Country{1}), ...
                Year, ...
                NaN, ...
                NaN, ...
                NaN, ...
                NaN, ...
                NaN, ...
                'VariableNames', ...
                {'Country', ...
                 'Year', ...
                 'Solar_MW', ...
                 'Battery_MWh', ...
                 'SolarToBatteryRatio', ...
                 'TotalCost_USD', ...
                 'PercentDemandMet'});

            Results = [Results; NewRow];
            continue;

        end

        %%  RESULTS
        xOpt = z(1); % Installed Solar MW
        yOpt = z(2); % Installed Battery MWh

        ratio = xOpt / yOpt; % Solar-to-Battery Ratio

        % Calculate total energy generated and % demand satisfied
        EnergyGenerated_MWh = (8760 * CFcorr * xOpt) + (eta * DoD * yOpt);
        PercentDemandMet = min(100, (EnergyGenerated_MWh / Demand) * 100);

        fprintf('%d | Solar: %.1f MW | Battery: %.1f MWh | Ratio: %.4f | Demand Met: %.1f%%\n', ...
            Year, xOpt, yOpt, ratio, PercentDemandMet);

        NewRow = table( ...
            string(country.Country{1}), ...
            Year, ...
            xOpt, ...
            yOpt, ...
            ratio, ...
            -fval, ... % Total energy delivered (MWh)
            PercentDemandMet, ...
            'VariableNames', ...
            {'Country', ...
             'Year', ...
             'Solar_MW', ...
             'Battery_MWh', ...
             'SolarToBatteryRatio', ...
             'EnergyDelivered_MWh', ...
             'PercentDemandMet'});

        Results = [Results; NewRow];

    end

end


