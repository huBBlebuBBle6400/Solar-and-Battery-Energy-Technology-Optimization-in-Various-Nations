%% Polytope (For All Countries - 2026)


k_year = 1; % Year index (2026)
Year_demo = FutureYears(k_year);
numCountries = height(countries);


numCols = ceil(sqrt(numCountries));
numRows = ceil(numCountries / numCols);

figure('Name', sprintf('Feasible Polytopes - All Countries (%d)', Year_demo), ...
       'Color', 'w', 'Position', [50 50 1400 800]);

for c_idx = 1:numCountries
    country_demo = countries(c_idx, :);
    countryName = country_demo.Country{1};

   
    Demand_demo = DemandProjectionTable{c_idx, k_year+1};
    DailyDemand_demo = Demand_demo / 365;
    Budget_demo = BudgetProjectionTable{c_idx, k_year+1};
    CFcorr_demo = country_demo.CorrectedCapacityFactor;
    Land_demo = country_demo.LandAreaAvailableForSolar_km__;
    Rel_demo = country_demo.TargetReliability___;

    hours_storage_demo = 2; % Hours for 2026

  
    max_x = min(Demand_demo / (8760 * CFcorr_demo), Budget_demo / Csol) * 1.3;
    max_y = min(Demand_demo / (eta * DoD), Budget_demo / Cbat) * 1.3;

   
    if isnan(max_x) || max_x <= 0, max_x = 100; end
    if isnan(max_y) || max_y <= 0, max_y = 100; end

    x_mesh = linspace(0, max_x, 200);
    y_mesh = linspace(0, max_y, 200);
    [X, Y] = meshgrid(x_mesh, y_mesh);

  
    C1 = (8760 * CFcorr_demo .* X) + (eta * DoD .* Y) <= Demand_demo;
    C2 = (Csol .* X) + (Cbat .* Y) <= Budget_demo;
    C3 = (1 / SolarDensity .* X) <= Land_demo;
    C4 = Y <= (Rel_demo * DailyDemand_demo);
    C5 = Y >= (CFcorr_demo * hours_storage_demo .* X);

    % Combine all constraints for Feasible Region
    FeasibleRegion = C1 & C2 & C3 & C4 & C5;


    subplot(numRows, numCols, c_idx);
    hold on;

    % Shade the Feasible Region
    contourf(X, Y, double(FeasibleRegion), [1 1], 'FaceColor', [0.85 0.92 0.98], 'LineColor', 'none');

    % Represent Constraints as Lines
    plot(x_mesh, (Demand_demo - 8760 * CFcorr_demo * x_mesh) / (eta * DoD), 'r-', 'LineWidth', 1.2);
    plot(x_mesh, (Budget_demo - Csol * x_mesh) / Cbat, 'g-', 'LineWidth', 1.2);
    xline(Land_demo * SolarDensity, 'm-', 'LineWidth', 1.2);
    yline(Rel_demo * DailyDemand_demo, 'c-', 'LineWidth', 1.2);
    plot(x_mesh, CFcorr_demo * hours_storage_demo * x_mesh, '--', 'Color', [1 0.7 0], 'LineWidth', 1.2);

    
    c_results = Results(strcmp(Results.Country, countryName) & Results.Year == Year_demo, :);
    if ~isempty(c_results) && ~isnan(c_results.Solar_MW)
        plot(c_results.Solar_MW, c_results.Battery_MWh, 'p', 'MarkerSize', 10, ...
            'MarkerFaceColor', 'y', 'MarkerEdgeColor', 'k', 'LineWidth', 1.2);
    end

    xlim([0 max_x]);
    ylim([0 max_y]);
    xlabel('Solar [MW]', 'FontSize', 9);
    ylabel('Battery [MWh]', 'FontSize', 9);
    title(countryName, 'FontSize', 10, 'FontWeight', 'bold');
    grid on;
    box on;
end


