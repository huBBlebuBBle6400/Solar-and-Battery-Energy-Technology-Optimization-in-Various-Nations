historical_pop = readtable('Historical_Population.csv');
monthly_variables = readtable('Monthly_Values.csv');

%% Get Country Names

countryNames = countries.Country;

numCountries = length(countryNames);


ProjectedPopulation = zeros(numCountries,1);
K_values = zeros(numCountries,1);
A_values = zeros(numCountries,1);
rP_values = zeros(numCountries,1);

%% Population Projections

FutureYears = (2026:2045);

PopulationProjectionTable = table( ...
    countryNames, ...
    'VariableNames',{'Country'});

DemandProjectionTable = table( ...
    countryNames, ...
    'VariableNames',{'Country'});

%% Population Modeling up to 2045 

for c = 1:numCountries

    currentCountry = countryNames{c};

    fprintf('\n=====================================\n');
    fprintf('Processing %s\n',currentCountry);
    fprintf('=====================================\n');

    % Use Historical Population Data

    countryData = historical_pop( ...
        strcmp(historical_pop.Country,currentCountry), ...
        :);

    t = countryData.Year - 2000;

    Pobs = countryData.HistoricalPopulation_people_;

    % Initial Guess for Parameters

    beta0 = [2e8 10 0.05];

    % Fit Logistic Model

    mdl = fitnlm( ...
        t, ...
        Pobs, ...
        @logistic_function_population, ...
        beta0);

    % Get actual Parameters

    K = mdl.Coefficients.Estimate(1);
    A = mdl.Coefficients.Estimate(2);
    rP = mdl.Coefficients.Estimate(3);

    % Save Parameters

    K_values(c) = K;
    A_values(c) = A;
    rP_values(c) = rP;

    % Create Projection Curve

    t_curve = 0:45;

    P_curve = logistic_function_population( ...
        [K A rP], ...
        t_curve);

    Pfuture = P_curve(end);

    ProjectedPopulation(c) = Pfuture;


    FuturePopulations = zeros(1,length(FutureYears));

    for k = 1:length(FutureYears)

        t_future = FutureYears(k) - 2000;

        FuturePopulations(k) = ...
            logistic_function_population( ...
            [K A rP], ...
            t_future);

        PopulationProjectionTable{c,k+1} = ...
            FuturePopulations(k);

    end

    %  Results

    fprintf('Carrying Capacity K = %.0f\n',K);
    fprintf('Growth Rate rP = %.5f\n',rP);
    fprintf('Projected Population 2045 = %.0f\n',Pfuture);

    

    figure

    plot( ...
        t, ...
        Pobs, ...
        'o', ...
        'MarkerFaceColor','b')

    hold on

    plot( ...
        t_curve, ...
        P_curve, ...
        'LineWidth',2)

    xlabel('Years Since 2000')
    ylabel('Population')

    title(['Population Projection: ',currentCountry])

    legend( ...
        'Observed Population', ...
        'Logistic Projection', ...
        'Location','best')

    grid on

end

for k = 1:length(FutureYears)

    PopulationProjectionTable.Properties.VariableNames{k+1} = ...
        ['Pop_' num2str(FutureYears(k))];

end


%% Demand Projections


for c = 1:numCountries

    EAR = countries.ElectricityAccessRate___(c);

    EPC = ...
        countries. ...
        ElectricityConsumptionPerCapita_MWh_person_year_(c);

    for k = 1:length(FutureYears)

        PopulationValue = ...
            PopulationProjectionTable{c,k+1};

        DemandProjectionTable{c,k+1} = ...
            (PopulationValue * EPC) / EAR;

    end

end

for k = 1:length(FutureYears)

    DemandProjectionTable.Properties.VariableNames{k+1} = ...
        ['Demand_' num2str(FutureYears(k))];

end

%% Budget Projections

BudgetProjectionTable = table( ...
    countryNames, ...
    'VariableNames',{'Country'});

for c = 1:numCountries

    B0 = countries.EnergyBudget_USD_(c);

    rB = countries.BudgetGrowthRate(c);

    for k = 1:length(FutureYears)

        t = FutureYears(k)-2025;

        BudgetProjectionTable{c,k+1} = ...
            B0*(1+rB)^t;

    end

end

for k = 1:length(FutureYears)

    BudgetProjectionTable.Properties.VariableNames{k+1} = ...
        ['Budget_' num2str(FutureYears(k))];

end

